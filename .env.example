# =============================================================================
# BookUp — Google Calendar OAuth 2.0 Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials from Google Cloud Console.
# Never commit your real .env file to Git!

# Server Port
PORT=3001

# Frontend Application Origin (used for OAuth redirect target & CORS)
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Credentials
# Obtain from: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
# 1. Create an OAuth 2.0 Client ID (Application Type: "Web application")
# 2. In "Authorized redirect URIs", add:
#    - Development: http://localhost:5173/api/auth/google/callback
#    - Production:  https://bookup.in/api/auth/google/callback
# 3. In "Authorized JavaScript origins", add:
#    - Development: http://localhost:5173
#    - Production:  https://bookup.in
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# -----------------------------------------------------------------------------
# Token Encryption Key (AES-256-GCM)
# 32-byte hexadecimal string used to encrypt refresh tokens and access tokens at rest.
# Generate one in terminal using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# -----------------------------------------------------------------------------
# Supabase Configuration (Frontend & Backend MVP)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-or-anon-key

