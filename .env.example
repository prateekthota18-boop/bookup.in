# =============================================================================
# BOOKUP — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================
# Copy this file to .env for local development.
# For production, configure the respective variables in Vercel and Render dashboards.
# NEVER commit real secret values to Git!

# =============================================================================
# 1. FRONTEND / VERCEL (Client-side variables exposed in Vite bundle)
# =============================================================================
# Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon / publishable public API key (safe for client)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-or-anon-key

# Backend API base URL:
# - Local development: Leave empty (Vite proxies /api to http://localhost:3001)
# - Production (Vercel): https://<your-render-domain> (e.g. https://bookup-backend.onrender.com)
VITE_API_URL=

# =============================================================================
# 2. BACKEND / RENDER (Server-only variables — NEVER expose to client)
# =============================================================================
# Server listening port (Render provides PORT dynamically; fallback is 3001)
PORT=3001

# Allowed frontend origin for CORS and OAuth redirect returns:
# - Local development: http://localhost:5173
# - Production (Render): https://<your-vercel-domain> (e.g. https://bookup.vercel.app)
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 Credentials (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here

# Google OAuth 2.0 Redirect URI:
# - Local development: http://localhost:5173/api/auth/google/callback
# - Production: https://<your-render-domain>/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Token Encryption Key (AES-256-GCM)
# 32-byte (64-character) hexadecimal string for encrypting OAuth tokens at rest.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Supabase Server-side Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-or-anon-key

# RichAutomate WhatsApp API Configuration (Phase 4)
# Get your API key from RichAutomate Dashboard (https://richautomate.in)
RICH_AUTOMATE_API_KEY=your_richautomate_api_key_here

# Secret token to protect internal cron endpoint (/api/internal/notifications/process-reminders)
# Checked via X-Internal-Secret header by Supabase pg_cron / scheduled caller
INTERNAL_CRON_SECRET=your_random_internal_cron_secret_here

# Gmail SMTP Email Configuration (Phase 4b)
# Use your Gmail address and a 16-character Google App Password (not your account password)
# Generate App Password at: https://myaccount.google.com/apppasswords (requires 2FA enabled)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

